# ============================================================
# Agent local WiFi Zone — copier ce fichier vers agent/.env
# puis compléter. L'agent ne contient JAMAIS de secret en clair
# dans le dépôt. Ce fichier est un gabarit.
#
# ASTUCE : agent/.env est lu automatiquement par `node main.mjs`
# (pas besoin de --env-file). Vérifier l'installation avec :
#   node main.mjs --doctor
# ============================================================

# Supabase (projet PROTOTYPE).
SUPABASE_URL=https://hwwivzsdepzdgonfbkxq.supabase.co

# Token de l'agent : la valeur dont le sha256 hex est stocké dans
# local_agents.token_hash (voir docs/TEST-MIKROTIK-MERCREDI.md,
# section « Enregistrer l'agent »).
AGENT_TOKEN=changez-moi

# MÊME secret que NETWORK_HMAC_SECRET du serveur (Edge Functions).
# Requis en mode mikrotik ; ignoré avec un avertissement en mode mock.
NETWORK_HMAC_SECRET=changez-moi

# mock = simulateur sans équipement (déroulé de bout en bout),
# mikrotik = équipement réel.
NETWORK_ADAPTER_TYPE=mikrotik

# Protocole vers le MikroTik. À CHOISIR SELON LA VERSION DU ROUTEUR
# (Winbox > System > Resources > Version) — c'est le piège n°1 du
# jour J, l'agent ne peut pas le deviner tout seul :
#
#   rest : API REST RouterOS. N'EXISTE QU'À PARTIR DE RouterOS 7.1.
#          - RouterOS 7.9+ : HTTP possible (service `www`, port 80)
#          - RouterOS 7.1–7.8 : HTTPS seulement (service `www-ssl`)
#   api  : API binaire, disponible sur TOUTES les versions. Port 8728.
#          L'agent gère les DEUX générations d'authentification :
#          - 6.43+ / 7.x : le mot de passe en clair est accepté ;
#          - < 6.43      : le routeur le REFUSE et renvoie un défi
#                          (`=ret=`), auquel l'agent répond
#                          "00" + md5(0x00 || mdp || défi).
#          Rien à configurer : le routeur décide, l'agent s'adapte.
#
# Un routeur RouterOS 6.x n'a AUCUNE API REST : y mettre `rest`
# donne un échec immédiat (HTTP 404 MUET, indiscernable d'un
# routeur éteint). Un hAP ac²sort d'usine en 6.42.3 → `api`.
# EN CAS DE DOUTE SUR UN hAP : `api`. C'est le seul choix qui
# marche sur 6.x ET sur 7.x.
AGENT_ROUTER_PROTOCOL=api

# Routeur (mode mikrotik).
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=changez-moi

# Chiffrement du transport vers le routeur.
#   false → REST en HTTP  sur le port 80   (service `www`, 7.9+)
#   true  → REST en HTTPS sur le port 443  (certificat auto-signé,
#           service `www-ssl`) — SEULE option sur RouterOS 7.1–7.8
MIKROTIK_TLS=false

# Port REST : LAISSER VIDE pour qu'il soit déduit du TLS
# (80 sans TLS, 443 avec TLS). Un couple incoherent — par exemple
# TLS=false avec le port 443 — est refuse au demarrage : c'etait
# la cause du premier echec de connexion sur routeur.
MIKROTIK_PORT_REST=

# Port de l'API binaire RouterOS (uniquement si AGENT_ROUTER_PROTOCOL=api).
MIKROTIK_PORT_API=8728

# Plafond de la file de comptage : 0/0 = aucune limitation, la file
# ne fait que compter (le quota est applique par le serveur).
MIKROTIK_MAX_LIMIT=0/0

# Nom de l'address-list de coupe dure (à créer en amont sur le routeur).
WIFI_LIST_NAME=wz-active

# Fréquences des boucles de l'agent (millisecondes).
AGENT_FETCH_INTERVAL_MS=2000
AGENT_PING_INTERVAL_MS=15000
AGENT_COLLECT_INTERVAL_MS=10000
AGENT_EXPIRE_INTERVAL_MS=20000

# Mock : consommation générée par client actif (octets/seconde).
AGENT_MOCK_BYTES_PER_SEC=120000

# Traces détaillées de l'agent (journal verbeux).
AGENT_DEBUG=false