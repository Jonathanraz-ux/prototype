# ===========================================
# WiFi Zone — Variables d'environnement
# ===========================================
# Copier ce fichier en .env et renseigner les valeurs.
# NE JAMAIS commiter le fichier .env dans Git.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Application ---
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEFAULT_SITE_ID=

# --- Mode réseau (fournisseur d'accès) ---
# mikrotik        : FOURNISSEUR RÉEL — agent local + routeur MikroTik.
#                   Seul mode utilisable en production : c'est le
#                   routeur qui coupe le trafic non autorisé.
# android_vpn_demo: simulation locale (VPN démo, aucun équipement requis).
#                   Refusée en production sauf confirmation explicite.
# mock            : aucun accès réseau (développement isolé).
# Valeur par défaut : mikrotik
# EXPO_PUBLIC_NETWORK_MODE=mikrotik

# Démo VPN tolérée en production (déjà le cas : garder "false").
# EXPO_PUBLIC_ALLOW_VPN_DEMO_IN_PRODUCTION=false

# --- Licence ---
EXPO_PUBLIC_LICENSE_API_URL=

# --- Support & Légal ---
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- Supabase Edge Functions Secrets (côté serveur uniquement) ---
# SUPABASE_SERVICE_ROLE_KEY=
# LICENSE_SIGNING_SECRET=
# NETWORK_ADAPTER_TYPE=
# RADIUS_HOST=
# RADIUS_PORT=
# RADIUS_SECRET=
# MIKROTIK_HOST=
# MIKROTIK_USERNAME=
# MIKROTIK_PASSWORD=
#
# --- Honnêteté de la chaîne réseau (fail closed) -----------------------
# L'agent local choisit son pilote par l'argument CLI `--mock`, que la
# fonction serveur ne voit pas. Le serveur ne peut donc affirmer qu'un routeur
# réel sur une CONFIRMATION EXPLICITE de l'opérateur :
#   MIKROTIK_MOCK=1  → simulation assumée (prime sur MIKROTIK_REAL si les
#                      deux sont posés)
#   MIKROTIK_REAL=1  → matériel réel confirmé
#   (aucune des deux)→ `simulated: true` : l'app affiche « routeur simulé »
#                      plutôt que d'affirmer un routeur inexistant.
# NE PAS poser MIKROTIK_REAL=1 tant que le routeur n'est pas réellement
# branché : c'est précisément ce drapeau qui fait mentir l'interface.
# # MIKROTIK_MOCK=
# # MIKROTIK_REAL=
# ADVERTISEMENT_PROOF_SECRET=